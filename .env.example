# ─── Database connection strings (consumed by sequelize.js and db.config.js) ───
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DEV_DATABASE_URL=postgres://postgres:password@localhost:5432/hackathon_dev
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/hackathon_test
DATABASE_URL=postgres://postgres:password@localhost:5432/hackathon_prod

PORT=3000
NODE_ENV=development

# ─── Neon API credentials (required by the Rollback Agent in SKILL.md) ────────
# Get these from https://console.neon.tech → your project → Settings
# NEVER commit real values — add them to your actual .env file (gitignored)
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
